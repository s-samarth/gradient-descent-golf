{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Gradient Descent Golf",
  "description": "Nine holes of real gradient descent. Drag to pick a learning rate, release, and watch the ball step toward the global minimum. Too small crawls, too big explodes.",
  "tags": ["game", "golf", "educational", "machine-learning", "math", "puzzle"],
  "permissions": ["haptics", "backgroundMusic"],
  "dependencies": [],
  "game": {
    "progress": {
      "course": { "label": "Course progress", "stateSchemaVersion": 1, "ttlDays": 30 }
    }
  },
  "memory": {
    "records": {
      "course_strokes": {
        "label": "Strokes",
        "valueType": "number",
        "order": "asc",
        "format": "integer",
        "periods": ["weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "gameplay": { "label": "Gameplay" },
      "visual": { "label": "Visual feel" },
      "audio": { "label": "Audio" }
    },
    "knobs": {
      "eta_min": { "label": "Smallest learning rate", "type": "number", "default": 0.0005, "min": 0.0001, "max": 0.01, "step": 0.0001, "group": "gameplay", "intent": "difficulty", "apply": "live" },
      "eta_max": { "label": "Largest learning rate", "type": "number", "default": 0.6, "min": 0.1, "max": 2, "step": 0.05, "group": "gameplay", "intent": "difficulty", "apply": "live" },
      "max_steps": { "label": "Descent steps per stroke", "type": "integer", "default": 30, "min": 8, "max": 80, "step": 1, "group": "gameplay", "intent": "difficulty", "apply": "live" },
      "hop_ms": { "label": "Time per step", "type": "duration_ms", "default": 110, "min": 40, "max": 300, "step": 10, "group": "visual", "intent": "feel", "apply": "live" },
      "accent_color": { "label": "Learning-rate accent", "type": "color", "default": "#ffd166", "group": "visual", "intent": "visual", "apply": "live" },
      "music_volume": { "label": "Music volume", "type": "percent", "default": 0.3, "min": 0, "max": 1, "step": 0.05, "group": "audio", "intent": "audio", "apply": "live" }
    }
  },
  "onboarding": {
    "kind": "guided",
    "version": 1,
    "steps": [
      { "id": "aim", "title": "Drag to set η", "body": "Press anywhere and pull. Farther means a bigger learning rate. You don't aim: the gradient does.", "advance": "interaction" },
      { "id": "update", "title": "θ ← θ − η·∇L", "body": "Each hop is one real gradient descent step toward lower loss.", "advance": "continue" },
      { "id": "goal", "title": "Find the global minimum", "body": "Tiny η crawls and gets stuck in local dips. Big η escapes them but can explode. Sink it under par.", "advance": "continue" }
    ]
  }
}
